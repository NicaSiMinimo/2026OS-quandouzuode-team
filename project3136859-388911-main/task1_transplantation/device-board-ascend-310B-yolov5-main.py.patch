--- a/device/board/ascend/310B/yolov5/main.py
+++ b/device/board/ascend/310B/yolov5/main.py
@@ -0,0 +1,337 @@
+import argparse
+import json
+import time
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+COCO_CLASSES = (
+    "person", "bicycle", "car", "motorcycle", "airplane", "bus", "train", "truck", "boat", "traffic light",
+    "fire hydrant", "stop sign", "parking meter", "bench", "bird", "cat", "dog", "horse", "sheep", "cow",
+    "elephant", "bear", "zebra", "giraffe", "backpack", "umbrella", "handbag", "tie", "suitcase", "frisbee",
+    "skis", "snowboard", "sports ball", "kite", "baseball bat", "baseball glove", "skateboard", "surfboard", "tennis racket", "bottle",
+    "wine glass", "cup", "fork", "knife", "spoon", "bowl", "banana", "apple", "sandwich", "orange",
+    "broccoli", "carrot", "hot dog", "pizza", "donut", "cake", "chair", "couch", "potted plant", "bed",
+    "dining table", "toilet", "tv", "laptop", "mouse", "remote", "keyboard", "cell phone", "microwave", "oven",
+    "toaster", "sink", "refrigerator", "book", "clock", "vase", "scissors", "teddy bear", "hair drier", "toothbrush",
+)
+
+IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".bmp", ".webp"}
+
+
+def load_classes(path):
+    if not path:
+        return list(COCO_CLASSES)
+    names = []
+    with open(path, "r", encoding="utf-8") as f:
+        for line in f:
+            name = line.strip()
+            if name:
+                names.append(name)
+    if not names:
+        raise ValueError(f"empty class file: {path}")
+    return names
+
+
+def letterbox(image, new_shape=(640, 640), color=(114, 114, 114), scaleup=True):
+    shape = image.shape[:2]
+    if isinstance(new_shape, int):
+        new_shape = (new_shape, new_shape)
+    gain = min(new_shape[0] / shape[0], new_shape[1] / shape[1])
+    if not scaleup:
+        gain = min(gain, 1.0)
+    new_unpad = (int(round(shape[1] * gain)), int(round(shape[0] * gain)))
+    dw = new_shape[1] - new_unpad[0]
+    dh = new_shape[0] - new_unpad[1]
+    dw /= 2
+    dh /= 2
+    if shape[::-1] != new_unpad:
+        image = cv2.resize(image, new_unpad, interpolation=cv2.INTER_LINEAR)
+    top = int(round(dh - 0.1))
+    bottom = int(round(dh + 0.1))
+    left = int(round(dw - 0.1))
+    right = int(round(dw + 0.1))
+    image = cv2.copyMakeBorder(image, top, bottom, left, right, cv2.BORDER_CONSTANT, value=color)
+    return image, gain, (dw, dh)
+
+
+def preprocess(image_bgr, img_size, dtype):
+    padded, gain, pad = letterbox(image_bgr, img_size)
+    rgb = cv2.cvtColor(padded, cv2.COLOR_BGR2RGB)
+    tensor = rgb.transpose(2, 0, 1)[None]
+    tensor = np.ascontiguousarray(tensor)
+    if dtype == "fp16":
+        tensor = tensor.astype(np.float16) / np.float16(255.0)
+    else:
+        tensor = tensor.astype(np.float32) / np.float32(255.0)
+    return tensor, gain, pad
+
+
+def xywh2xyxy(boxes):
+    out = np.empty_like(boxes)
+    out[:, 0] = boxes[:, 0] - boxes[:, 2] / 2
+    out[:, 1] = boxes[:, 1] - boxes[:, 3] / 2
+    out[:, 2] = boxes[:, 0] + boxes[:, 2] / 2
+    out[:, 3] = boxes[:, 1] + boxes[:, 3] / 2
+    return out
+
+
+def clip_boxes(boxes, shape):
+    boxes[:, [0, 2]] = boxes[:, [0, 2]].clip(0, shape[1] - 1)
+    boxes[:, [1, 3]] = boxes[:, [1, 3]].clip(0, shape[0] - 1)
+    return boxes
+
+
+def scale_boxes(boxes, original_shape, gain, pad):
+    boxes[:, [0, 2]] -= pad[0]
+    boxes[:, [1, 3]] -= pad[1]
+    boxes[:, :4] /= gain
+    return clip_boxes(boxes, original_shape)
+
+
+def nms(boxes, scores, class_ids, iou_thres, agnostic=False):
+    if boxes.size == 0:
+        return []
+    boxes = boxes.astype(np.float32)
+    scores = scores.astype(np.float32)
+    offsets = class_ids.astype(np.float32) * (0.0 if agnostic else 4096.0)
+    boxes_for_nms = boxes.copy()
+    boxes_for_nms[:, [0, 2]] += offsets[:, None]
+    boxes_for_nms[:, [1, 3]] += offsets[:, None]
+    x1, y1, x2, y2 = boxes_for_nms.T
+    areas = np.maximum(0.0, x2 - x1) * np.maximum(0.0, y2 - y1)
+    order = scores.argsort()[::-1]
+    keep = []
+    while order.size > 0:
+        i = int(order[0])
+        keep.append(i)
+        if order.size == 1:
+            break
+        rest = order[1:]
+        xx1 = np.maximum(x1[i], x1[rest])
+        yy1 = np.maximum(y1[i], y1[rest])
+        xx2 = np.minimum(x2[i], x2[rest])
+        yy2 = np.minimum(y2[i], y2[rest])
+        inter_w = np.maximum(0.0, xx2 - xx1)
+        inter_h = np.maximum(0.0, yy2 - yy1)
+        inter = inter_w * inter_h
+        union = areas[i] + areas[rest] - inter + 1e-7
+        iou = inter / union
+        order = rest[iou <= iou_thres]
+    return keep
+
+
+def to_numpy(output):
+    if hasattr(output, "to_numpy"):
+        return output.to_numpy()
+    if hasattr(output, "numpy"):
+        return output.numpy()
+    return np.asarray(output)
+
+
+def select_prediction(outputs):
+    if isinstance(outputs, dict):
+        outputs = list(outputs.values())
+    candidates = []
+    for output in outputs:
+        arr = to_numpy(output)
+        if arr is None:
+            continue
+        arr = np.asarray(arr)
+        if arr.size == 0:
+            continue
+        arr = np.squeeze(arr)
+        if arr.ndim == 1 and arr.shape[0] >= 6:
+            arr = arr.reshape(1, -1)
+        elif arr.ndim == 2 and arr.shape[-1] >= 6:
+            pass
+        elif arr.ndim == 3 and arr.shape[0] == 1 and arr.shape[-1] >= 6:
+            arr = arr[0]
+        elif arr.ndim >= 3 and arr.shape[-1] >= 6:
+            arr = arr.reshape(-1, arr.shape[-1])
+        else:
+            continue
+        candidates.append(arr)
+    if not candidates:
+        raise RuntimeError("cannot find a YOLO-like output tensor; expected shape [1, N, 85] or [N, 6]")
+    candidates.sort(key=lambda x: x.shape[0], reverse=True)
+    return candidates[0].astype(np.float32)
+
+
+def postprocess(outputs, original_shape, gain, pad, conf_thres, iou_thres, agnostic=False):
+    pred = select_prediction(outputs)
+    if pred.shape[1] == 6:
+        boxes = pred[:, :4]
+        scores = pred[:, 4]
+        class_ids = pred[:, 5].astype(np.int32)
+        mask = scores >= conf_thres
+        boxes = boxes[mask]
+        scores = scores[mask]
+        class_ids = class_ids[mask]
+    else:
+        boxes = xywh2xyxy(pred[:, :4])
+        objectness = pred[:, 4]
+        class_scores = pred[:, 5:]
+        class_ids = np.argmax(class_scores, axis=1).astype(np.int32)
+        scores = objectness * class_scores[np.arange(class_scores.shape[0]), class_ids]
+        mask = scores >= conf_thres
+        boxes = boxes[mask]
+        scores = scores[mask]
+        class_ids = class_ids[mask]
+    if boxes.size == 0:
+        return []
+    boxes = scale_boxes(boxes, original_shape, gain, pad)
+    keep = nms(boxes, scores, class_ids, iou_thres, agnostic=agnostic)
+    detections = []
+    for idx in keep:
+        detections.append({
+            "box": boxes[idx].round(2).tolist(),
+            "score": float(round(float(scores[idx]), 6)),
+            "class_id": int(class_ids[idx]),
+        })
+    return detections
+
+
+def color_for_class(class_id):
+    rng = np.random.default_rng(class_id + 2026)
+    color = rng.integers(64, 255, size=3, dtype=np.uint8)
+    return int(color[0]), int(color[1]), int(color[2])
+
+
+def draw_detections(image, detections, class_names):
+    canvas = image.copy()
+    for det in detections:
+        x1, y1, x2, y2 = [int(round(v)) for v in det["box"]]
+        cls_id = det["class_id"]
+        score = det["score"]
+        name = class_names[cls_id] if 0 <= cls_id < len(class_names) else str(cls_id)
+        label = f"{name} {score:.2f}"
+        color = color_for_class(cls_id)
+        cv2.rectangle(canvas, (x1, y1), (x2, y2), color, 2)
+        text_size, baseline = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.55, 2)
+        y_text = max(y1, text_size[1] + 4)
+        cv2.rectangle(canvas, (x1, y_text - text_size[1] - 4), (x1 + text_size[0] + 4, y_text + baseline), color, -1)
+        cv2.putText(canvas, label, (x1 + 2, y_text - 2), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 2, cv2.LINE_AA)
+    return canvas
+
+
+class InferEngine:
+    def __init__(self, model_path, backend, device_id):
+        self.model_path = str(model_path)
+        self.backend = backend
+        self.device_id = device_id
+        if backend == "auto":
+            suffix = Path(model_path).suffix.lower()
+            backend = "ais_bench" if suffix == ".om" else "onnxruntime"
+            self.backend = backend
+        if self.backend == "ais_bench":
+            from ais_bench.infer.interface import InferSession
+            self.session = InferSession(device_id, self.model_path)
+        elif self.backend == "onnxruntime":
+            import onnxruntime as ort
+            self.session = ort.InferenceSession(self.model_path, providers=["CPUExecutionProvider"])
+            self.input_name = self.session.get_inputs()[0].name
+        else:
+            raise ValueError(f"unsupported backend: {backend}")
+
+    def infer(self, input_tensor):
+        start = time.perf_counter()
+        if self.backend == "ais_bench":
+            outputs = self.session.infer([input_tensor])
+        else:
+            outputs = self.session.run(None, {self.input_name: input_tensor})
+        latency_ms = (time.perf_counter() - start) * 1000.0
+        return outputs, latency_ms
+
+
+def collect_images(image, input_dir):
+    paths = []
+    if image:
+        paths.append(Path(image))
+    if input_dir:
+        root = Path(input_dir)
+        for path in sorted(root.rglob("*")):
+            if path.suffix.lower() in IMAGE_SUFFIXES:
+                paths.append(path)
+    if not paths:
+        raise ValueError("no input image is provided")
+    return paths
+
+
+def resolve_output_path(input_path, output_arg, multi):
+    output = Path(output_arg)
+    if multi or output.suffix == "":
+        output.mkdir(parents=True, exist_ok=True)
+        return output / f"{input_path.stem}_detected{input_path.suffix}"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    return output
+
+
+def save_txt(path, detections):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "w", encoding="utf-8") as f:
+        for det in detections:
+            box = det["box"]
+            f.write(f"{det['class_id']} {det['score']:.6f} {box[0]:.2f} {box[1]:.2f} {box[2]:.2f} {box[3]:.2f}\n")
+
+
+def run(args):
+    class_names = load_classes(args.classes)
+    engine = InferEngine(args.model, args.backend, args.device_id)
+    image_paths = collect_images(args.image, args.input_dir)
+    summary = []
+    for index, image_path in enumerate(image_paths, 1):
+        image = cv2.imread(str(image_path))
+        if image is None:
+            raise RuntimeError(f"failed to read image: {image_path}")
+        input_tensor, gain, pad = preprocess(image, args.img_size, args.dtype)
+        outputs, latency_ms = engine.infer(input_tensor)
+        detections = postprocess(outputs, image.shape[:2], gain, pad, args.conf_thres, args.iou_thres, args.agnostic_nms)
+        result = draw_detections(image, detections, class_names)
+        output_path = resolve_output_path(image_path, args.output, len(image_paths) > 1)
+        ok = cv2.imwrite(str(output_path), result)
+        if not ok:
+            raise RuntimeError(f"failed to write image: {output_path}")
+        if args.save_txt:
+            save_txt(output_path.with_suffix(".txt"), detections)
+        item = {
+            "image": str(image_path),
+            "output": str(output_path),
+            "detections": detections,
+            "latency_ms": round(latency_ms, 3),
+        }
+        summary.append(item)
+        print(f"[{index}/{len(image_paths)}] {image_path} -> {output_path}, detections={len(detections)}, latency_ms={latency_ms:.3f}")
+    if args.json:
+        json_path = Path(args.json)
+        json_path.parent.mkdir(parents=True, exist_ok=True)
+        with open(json_path, "w", encoding="utf-8") as f:
+            json.dump(summary, f, ensure_ascii=False, indent=2)
+    return 0
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="YOLOv5 object detection inference on Ascend CANN OM model.")
+    parser.add_argument("--model", required=True, help="Path to yolov5 .om model for Ascend or .onnx model for CPU smoke test.")
+    parser.add_argument("--image", help="Single input image path.")
+    parser.add_argument("--input-dir", help="Directory containing input images.")
+    parser.add_argument("--output", default="output", help="Output image path or output directory.")
+    parser.add_argument("--classes", help="Class name file. Default uses COCO 80 classes.")
+    parser.add_argument("--backend", default="auto", choices=["auto", "ais_bench", "onnxruntime"])
+    parser.add_argument("--device-id", type=int, default=0)
+    parser.add_argument("--img-size", type=int, default=640)
+    parser.add_argument("--dtype", default="fp32", choices=["fp32", "fp16"])
+    parser.add_argument("--conf-thres", type=float, default=0.25)
+    parser.add_argument("--iou-thres", type=float, default=0.45)
+    parser.add_argument("--agnostic-nms", action="store_true")
+    parser.add_argument("--save-txt", action="store_true")
+    parser.add_argument("--json", help="Path to save JSON detection summary.")
+    args = parser.parse_args()
+    if not args.image and not args.input_dir:
+        parser.error("one of --image or --input-dir is required")
+    return args
+
+
+if __name__ == "__main__":
+    raise SystemExit(run(parse_args()))
